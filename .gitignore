# Never ignore the explicit omission metadata.
!LARGE_FILES_OMITTED.tsv
!**/*.placeholder.md
!**/DIRECTORY_PLACEHOLDER.md
!.stage3_cuda/
!.stage3_cuda/**/*.placeholder.md
!.stage3_deps/
