!repo/ec_out_50/
!repo/ec_out_50/**/*.placeholder.md
!repo/ec_out_debug/
!repo/ec_out_debug/**/*.placeholder.md

# PathGraph-SARM U0/U1: local data, checkpoints, and duplicate package work.
# Compact manifests, job_result.json records, and placeholder documents remain tracked.
/artifacts/pathgraph_sarm/upgrade_v2/data/
/artifacts/pathgraph_sarm/upgrade_v2/runs/**/*.pt
/artifacts/pathgraph_sarm/upgrade_v2/u0_u1_export/
/artifacts/pathgraph_sarm/upgrade_v2/results/u0_u1_export/
/artifacts/pathgraph_sarm/upgrade_v2/results/u0_corrected/transition_metrics.csv
/downloads/upgrade_v2/.u0_u1_export_work/
/downloads/upgrade_v2/*.zip.sha256
!artifacts/pathgraph_sarm/upgrade_v2/runs/
!artifacts/pathgraph_sarm/upgrade_v2/runs/**/
!artifacts/pathgraph_sarm/upgrade_v2/runs/README.md
!artifacts/pathgraph_sarm/upgrade_v2/runs/**/job_result.json
