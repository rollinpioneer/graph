{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathgraph.local/l1v/coarse_graph.schema.json",
  "title": "L1V visual coarse semantic graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_interpretation",
    "objects",
    "nodes",
    "edges",
    "physical_checks",
    "needs_clarification"
  ],
  "properties": {
    "schema_version": {"const": "l1v_coarse_graph_v1"},
    "goal_interpretation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "objects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "role", "observability", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 300},
          "role": {"enum": ["manipulated_object", "target", "obstacle", "distractor", "unknown"]},
          "observability": {"enum": ["observed", "partially_observed", "not_observed", "ambiguous"]},
          "status": {"const": "hypothesized"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "role", "observable_conditions", "unknown_conditions", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "role": {"enum": ["start", "observation", "intermediate", "goal", "clarification", "recovery"]},
          "observable_conditions": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "unknown_conditions": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "status": {"const": "hypothesized"}
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "src", "dst", "action", "preconditions", "expected_effects", "trigger", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
          "src": {"type": "string"},
          "dst": {"type": "string"},
          "action": {"type": "string", "minLength": 1, "maxLength": 500},
          "preconditions": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "expected_effects": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "trigger": {"type": ["string", "null"], "maxLength": 300},
          "status": {"const": "hypothesized"}
        }
      }
    },
    "physical_checks": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "needs_clarification": {"type": "boolean"},
    "clarification_question": {"type": ["string", "null"], "maxLength": 500}
  }
}
