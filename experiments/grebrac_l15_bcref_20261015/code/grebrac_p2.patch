+    def bc_ref_loss(self, batch, grad_params):
+        """Plain (unweighted) MSE behavior cloning for the BC reference network."""
+        ref_actions = self.network.select("bc_ref")(batch["observations"], params=grad_params).mode()
+        mse = jnp.square(ref_actions - batch["actions"]).sum(axis=-1).mean()
+        return mse, {"mse": mse}
+
+    def compute_guidance(self, batch, actor_actions, lam):
+        """GFP guidance weights (gfp.py compute_guidance) with `actor_actions` as the reference."""
+        agg_fn = getattr(jnp, self.config["q_agg"])
+        obs = batch["observations"]
+        q_data = agg_fn(
+            self.network.select("target_critic")(obs, actions=batch["actions"]), axis=0
+        )
+        q_ref = agg_fn(
+            self.network.select("target_critic")(obs, actions=actor_actions), axis=0
+        )
+        scale = lam / self.config["eta_temperature"]
+        scl_q_data = scale * q_data
+        scl_q_ref = scale * q_ref
+        log_denominator = logsumexp(jnp.stack([scl_q_data, scl_q_ref], axis=-1), axis=-1)
+        guidance = jnp.exp(scl_q_data - log_denominator)
+        if self.config["guidance_normalize"]:
+            # Keep the batch-average BC strength of the tuned ReBRAC alpha_actor.
+            weights = guidance / jnp.maximum(guidance.mean(), 1e-6)
+        else:
+            weights = guidance
