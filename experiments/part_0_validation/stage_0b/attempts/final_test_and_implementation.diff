+    for i,cid in enumerate(a.candidate_ids):
+        torch.testing.assert_close(a.logits[i]-a.diagnostics['delta'][cid],b.logits[i],atol=1e-6,rtol=1e-5)
+    assert snap.facts is empty.facts and snap.base_input==empty.base_input
